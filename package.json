{
  "name": "@manvith-003/secure-captcha",
  "version": "0.1.1",
  "description": "Reusable numeric image CAPTCHA library for Node.js and Express applications with client widget",
  "type": "module",
  "license": "MIT",
  "author": "",
  "keywords": [
    "captcha",
    "image-captcha",
    "numeric-captcha",
    "express-captcha",
    "nodejs",
    "security"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./client/css": "./dist/client.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch examples/express/server.js",
    "start:server": "node examples/express/server.js",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "devDependencies": {
    "express": "^5.3.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
